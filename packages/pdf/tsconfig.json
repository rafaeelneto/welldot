{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "~/*": ["./src/*"],
      "@welldot/pdf/fonts": ["./src/fonts.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
