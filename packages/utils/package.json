{
  "name": "@welldot/utils",
  "version": "0.3.0",
  "description": "Profile analysis utilities for the .well open format — depth, diameter, cylindrical volume, gravel pack estimates, and aquifer hydraulics.",
  "keywords": [
    "well",
    "water-well",
    "hydrogeology",
    "geoscience",
    "borehole",
    "aquifer",
    "volume",
    "gravel-pack",
    "drawdown",
    "transmissivity"
  ],
  "type": "module",
  "author": {
    "name": "Rafael Neto",
    "email": "rafaelneto.g@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/rafaeelneto/welldot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaeelneto/welldot.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/rafaeelneto/welldot/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@welldot/core": "workspace:*",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@welldot/lint": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist"
  ]
}
