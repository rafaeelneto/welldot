{
  "name": "welldot",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SIAGAS_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "EVENTS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "preview-welldot",
      "ratelimits": [
        {
          "name": "SHARE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "SIAGAS_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "EVENTS_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
